# Configuración de entorno local / Railway para Hub Marcas LPS (Artesanitas Perú)
# Copia este archivo como `.env` para desarrollo local. NUNCA subas `.env` a Git.

PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
DB_POOL_MAX=5

# Secreto JWT obligatorio en producción (mínimo 32 caracteres aleatorios)
JWT_SECRET=reemplazar_por_secreto_criptografico_min_32_caracteres_2026
DEFAULT_TENANT_SLUG=artesanitas

# Orígenes CORS adicionales separados por coma (opcional)
CORS_ORIGINS=https://artesanitas.lospilares.pe,https://lospilares.pe

# Credenciales de Mercado Pago EXCLUSIVAS de Artesanitas (Nunca mezclar con Los Pilares)
MP_ACCESS_TOKEN_ARTESANITAS=
MP_PUBLIC_KEY_ARTESANITAS=
MP_WEBHOOK_SECRET_ARTESANITAS=

# Visión IA Anti-Fraude para verificación automática de vouchers Yape/Plin (Gemini 2.5 Flash)
GEMINI_API_KEY=

# Meta Pixel & Conversions API (CAPI Server-Side deduplicación 1:1)
META_PIXEL_ID=851775257895823
META_CAPI_TOKEN=

# Web Push VAPID Keys (Opcional para notificaciones Push en vivo)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:artesanitas.pe@gmail.com

# Migración segura (desactivado por defecto en producción)
MIGRATION_SNAPSHOT_SECRET=
ENABLE_LEGACY_SYNC=false

# Opcional: Almacenamiento externo Cloudflare R2 (S3-compatible) cuando superes 5,000 fotos
R2_PUBLIC_BASE_URL=
