{
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript"
  ],
  "tailwindCSS.includeLanguages": {
    "javascript": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    [
      "class(?:Name)?\\s*=\\s*[\"'`]([^\"'`]*)[\"'`]",
      "([^\\s]+)"
    ]
  ],
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.delay": 300
}
